{
  "name": "@mattia/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Componenti, hook e token di tema riusabili tra i siti (Next.js 16 + React 19 + Tailwind 4).",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/styles.css",
    "./theme.css": "./src/styles/theme.css",
    "./base.css": "./src/styles/base.css",
    "./shell.css": "./src/styles/shell.css",
    "./components.css": "./src/styles/components.css",
    "./provider": "./src/provider.tsx",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "files": [
    "src"
  ],
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:demo": "npm run dev -w @mattia/demo-site",
    "build:demo": "npm run build -w @mattia/demo-site"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.26.0",
    "radix-ui": "^1.6.5",
    "react-day-picker": "^10.0.1",
    "shadcn": "^4.14.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "next-themes": "^0.4.6",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^29.1.1",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.8"
  }
}
